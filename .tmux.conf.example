# Mouse support
set -g mouse on

# Enable OSC 52 clipboard passthrough
# Useful for nvim clipboard over SSH
set -g set-clipboard on

# Faster escape key response (helps with nvim)
set -sg escape-time 10

# Enable focus events for nvim
set -g focus-events on

# Terminal settings
set -g default-terminal "screen-256color"
set -sa terminal-overrides ",xterm-256color:RGB"

# Copy mode clipboard integration
# macOS: pbcopy
# Linux: xclip if installed, otherwise xsel

# macOS
if-shell 'command -v pbcopy >/dev/null 2>&1' \
    "bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'pbcopy'"

# Linux (preferred)
if-shell 'command -v xclip >/dev/null 2>&1' \
    "bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'xclip -selection clipboard -in'"

# Linux (fallback)
if-shell 'command -v xsel >/dev/null 2>&1' \
    "bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'xsel --clipboard --input'"
